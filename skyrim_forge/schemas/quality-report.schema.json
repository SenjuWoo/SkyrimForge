{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skyrim-forge/quality-report.schema.json",
  "title": "Skyrim Forge Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mod_types",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "skyrim-forge-quality-report/1"
    },
    "mod_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "framework",
          "plugin",
          "papyrus",
          "native",
          "texture",
          "mesh",
          "animation",
          "lod",
          "audio",
          "package"
        ]
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARNING",
              "NOT_APPLICABLE",
              "NOT_RUN",
              "BLOCKED",
              "UNVERIFIED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "tool",
                    "dimension",
                    "subject",
                    "scope",
                    "result",
                    "artifact",
                    "sha256"
                  ],
                  "properties": {
                    "type": {
                      "const": "forge-tool"
                    },
                    "tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "const": "PASS"
                    },
                    "artifact": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    "dimension": {
                      "enum": [
                        "functional",
                        "compatibility",
                        "performance",
                        "resources",
                        "save_safety",
                        "conflicts",
                        "assets",
                        "installation",
                        "reproducibility",
                        "publication"
                      ]
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1,
                      "enum": [
                        "framework-source",
                        "framework-plan",
                        "framework-build",
                        "fomod-package",
                        "papyrus-source",
                        "native-source",
                        "native-binary",
                        "texture-file",
                        "audio-file",
                        "skse-binary",
                        "release-package"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
