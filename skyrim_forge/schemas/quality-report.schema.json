{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skyrim-forge/quality-report.schema.json",
  "title": "Skyrim Forge Quality Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["mod_types", "checks"],
  "properties": {
    "schema": {"const": "skyrim-forge-quality-report/1"},
    "mod_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["framework", "plugin", "papyrus", "native", "texture", "mesh", "animation", "lod", "audio", "package"]}
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"enum": ["PASS", "FAIL", "WARNING", "NOT_APPLICABLE", "NOT_RUN", "BLOCKED", "UNVERIFIED"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
